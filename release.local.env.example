# Copy to release.local.env in the repo root, or to
# %USERPROFILE%\.panelcad\release.env on the shop build PC.
# Both paths are gitignored. scripts/build-release.py fills any
# PANELCAD_RELEASE_* variable that is not already set. It does not
# print the values.
#
# python scripts/build-release.py --public ignores this file and
# embeds no webhook, bot, or update feed.

PANELCAD_RELEASE_BUG_WEBHOOK=
PANELCAD_RELEASE_SLACK_BOT_TOKEN=
PANELCAD_RELEASE_SLACK_CHANNEL=
PANELCAD_RELEASE_UPDATE_FEED=
